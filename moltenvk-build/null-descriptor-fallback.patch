+				desc.storageMode = MTLStorageModeShared;
+				_dummyNullDescriptorMTLTexture = [_physicalDevice->_mtlDevice newTextureWithDescriptor: desc];
+				uint32_t zeros = 0;
+				[_dummyNullDescriptorMTLTexture replaceRegion: MTLRegionMake2D(0, 0, 1, 1)
+												  mipmapLevel: 0
+													withBytes: &zeros
+												  bytesPerRow: 4];
+				_dummyNullDescriptorMTLTexture.label = @"MVKDummyNullDescriptorTexture";
+			}
+		}
+	}
